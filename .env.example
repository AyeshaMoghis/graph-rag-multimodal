# Copy to .env and fill in. Never commit .env.

# Groq: answer generation and triple extraction
GROQ_API_KEY=

# Neo4j: knowledge graph (docker compose provides bolt://localhost:7687)
NEO4J_URI=
NEO4J_USER=
NEO4J_PASSWORD=

# Optional: not used by the default pipeline
GEMINI_API_KEY=

# Optional overrides for any pipeline setting use the GRAPHRAG_ prefix, e.g.
# GRAPHRAG_CORPUS_DIR=data/sample
# GRAPHRAG_FUSION=rrf
